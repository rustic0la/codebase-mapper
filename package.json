    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
